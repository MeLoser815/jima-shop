# 复制为 apps/api/.env 后按需修改。不要把真实的 .env 提交到 Git。
# 前端开发服务器会读取同一份 apps/api/.env（也可用仓库根目录的 .env）。

# 服务端口
PORT=8001
HOST=0.0.0.0

# 管理后台的前端路径（前台导航不会展示入口，需手动输入地址）
# 开源默认是 /admin。生产环境建议在后台「账号安全」中修改。
# 若在此设置，将锁定后台路径，优先于后台中的修改。
# 不要使用 /api、/cart、/pay、/order、/query、/cashier 等前台保留路径
ADMIN_BASE_PATH=/admin

# 可选：仅当库中尚无管理员时，用环境变量自动创建账号
# 推荐不填，改用网页「首次安装」自行设置用户名+密码（密码至少 8 位）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-admin-password

# 会话签名密钥（HMAC，与登录密码无关）
# 生产环境必须换成足够长的随机串，禁止使用本文件中的示例占位值
SESSION_SECRET=change-me-session-secret-please!!

# 用于加密存储收款密钥与卡密的 AES 密钥（建议 32 字节以上随机串）
# 生产环境必须换成足够长的随机串，禁止使用本文件中的示例占位值
SETTINGS_ENCRYPTION_KEY=change-me-32-char-secret-key!!

# SQLite 数据库路径（相对 api 工作目录或绝对路径）
# 上线时请指向一个新的空文件，不要直接复用开发库中的演示数据
DATABASE_PATH=../../data/jima.db

# 支付宝异步通知完整 URL
# 开发环境可用 localhost HTTP；生产环境必须是公网 HTTPS
# 例: https://your-domain.com/api/payment/notify
ALIPAY_NOTIFY_URL=http://localhost:8001/api/payment/notify

# 网关。沙箱可改为 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# CORS / 前端地址。生产环境不要再额外放行 localhost。
# 若生产由 API 同域托管前端构建产物，填站点本身的 https 源即可
WEB_ORIGIN=http://localhost:5173

# 节点环境：development 可继续本地开发；production 会启用安全启动检查并托管前端构建
NODE_ENV=development

# 开发环境默认会写入示例分类/商品与 DEMO- 卡密。设为 0 可关闭。
# 生产环境（NODE_ENV=production）永远不会写入演示数据。
# JIMA_SEED_DEMO=0

# 反向代理信任。缺省仅信任上一跳为回环或私网的反代。
# 公网直连 8001 时，客户端 X-Forwarded-* 不会改写回调地址或限流 IP。
# 若前面是公网负载均衡，设为 true，并确保反代覆盖客户端转发头；设为 false 则完全不信任转发头。
# TRUST_PROXY=private
# TRUST_PROXY=true
# TRUST_PROXY=false

