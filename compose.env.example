# 与 docker-compose.yml / docker-compose.build.yml 配套。
# 复制为 .env 后填写真实值，再执行 docker compose up -d。
# 1Panel 用户请在编排的「环境变量」中填写同名变量，不必使用本文件。
# 不要将填写后的 .env 提交到 Git，也不要使用下方的示例域名或空密钥上线。

WEB_ORIGIN=https://your-domain.com
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/notify

# 各生成一次，务必长期保管。丢失 SETTINGS_ENCRYPTION_KEY 将无法解密库中的支付宝密钥与卡密。
# 生成示例：openssl rand -hex 32
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=

# 可选
ADMIN_BASE_PATH=/admin
JIMA_PORT=3001
